---
import PageHeader from "@components/PageHeader.astro"
import JustifiedGallery from "@components/JustifiedGallery.astro"
import Layout from "@layouts/Layout.astro"
import { photography } from "@lib/content"
---

<Layout title="Photography">
	<div class="mx-4 mt-16 md:mx-8">
		{
			photography.page.header && (
				<PageHeader header={photography.page.header} description={photography.page.description} />
			)
		}

		{
			photography.images.length > 0 && (
				<div class="mt-8"><JustifiedGallery items={photography.images} priority /></div>
			)
		}
	</div>
</Layout>

