---
import PageHeader from "@components/PageHeader.astro"
import Photograph from "@components/Photograph.svelte"
import Layout from "@layouts/Layout.astro"
import { photography } from "@lib/content"
---

<Layout title="Photography">
	<div>
		{
			photography.page.header && (
				<PageHeader header={photography.page.header} description={photography.page.description} />
			)
		}

		{
			photography.images.length > 0 && (
				<div class="flex flex-wrap items-center justify-center">
					{photography.images.map((image) => (
						<div class="basis-1/1 mx-8 mt-8 md:basis-1/3">
							<Photograph image={image} client:load />
						</div>
					))}
				</div>
			)
		}
	</div>
</Layout>
