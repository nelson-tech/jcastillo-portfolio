---
import PageHeader from "@components/PageHeader.astro"
import Layout from "@layouts/Layout.astro"
import { music } from "@lib/content"

const { page, hero, spotifyArtists, press } = music
---

<Layout title={page.title ?? "Music"}>
	<div class="mx-4 md:mx-8">
		{page.header && <PageHeader header={page.header} description={page.description} />}
		{
			hero && (
				<div class="flex justify-center">
					<a href={hero.link} target="_blank" title={hero.image.alt}>
						<img src={hero.image.src} alt={hero.image.alt} />
					</a>
				</div>
			)
		}
		<div class="flex flex-wrap">
			{spotifyArtists.map((artist) => (
				<iframe
					style="border-radius:12px"
					src={`https://open.spotify.com/embed/artist/${artist.id}?utm_source=generator`}
					class="flex-1 p-4"
					height="400"
					frameborder="0"
					allowfullscreen=""
					allow="autoplay; clipboard-write; encrypted-media; fullscreen; picture-in-picture"
					loading="lazy"
				/>
			))}
		</div>
		<div id="press-releases" class="my-8 text-xl">
			{press.text && <h4 class="text-center">{press.text}</h4>}
			<div class="text-center">
				{press.links.map((link) => (
					<p class="font-bold">
						<a href={link.url} target="_blank" rel="noopener">
							{link.label}
						</a>
					</p>
				))}
			</div>
		</div>
	</div>
</Layout>

<style>
	#press-releases p {
		@apply mt-4;
	}

	#press-releases a {
		@apply text-highlight transition-colors hover:text-green-500;
	}
</style>
