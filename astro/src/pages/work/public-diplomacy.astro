---
import CompanyLogo from "@components/CompanyLogo.astro"
import PublicationCarousel from "@components/PublicationCarousel.svelte"
import Picture from "@components/Picture.astro"
import Layout from "@layouts/Layout.astro"
import { lazyIframes } from "@lib/embeds"
import { withInfo } from "@lib/images"
import { publicDiplomacy } from "@lib/content"

const { publications, writing, podcasts } = publicDiplomacy
// Logo height overrides from JSON (kept here so Tailwind generates them): max-h-7 max-h-10 max-h-12
---

<Layout title="Public Diplomacy">
	<div class="mx-4 mt-16 md:mx-8">
		<div id="publications" class="border-rule mb-8 border-t pt-12 pb-8">
			{
				publications.header && (
					<h2 class="text-highlight mb-8 w-full text-center text-4xl font-bold">{publications.header}</h2>
				)
			}
			<div class="mx-auto max-w-2xl">
				<PublicationCarousel
					publications={publications.items.map((item) => ({ ...item, image: withInfo(item.image) }))}
					client:load
				/>
			</div>
		</div>
		<section id="writing" class="border-rule mb-8 border-t pt-12 pb-8">
			<h2 class="text-highlight mb-8 w-full text-center text-4xl font-bold">{writing.header}</h2>
			<ul class="mx-auto max-w-2xl">
				{writing.items.map((item) => (
					<li class="border-rule flex items-center gap-6 border-t py-5 first:border-t-0">
						<div class="flex w-24 shrink-0 justify-center md:w-36">
							<CompanyLogo src={item.publisher.logo} alt={item.publisher.name} href={item.publisher.url} width={item.publisher.w} height={item.publisher.h} scale={item.publisher.s ?? 1} />
						</div>
						<div>
							<a href={item.link} target="_blank" rel="noopener" class="text-lg font-bold underline-offset-4 hover:underline">
								{item.title}
							</a>
							<p class="text-stone mt-1 text-base">
								{[item.publisher.name, item.label, item.year].filter(Boolean).join(" · ")}
							</p>
						</div>
					</li>
				))}
			</ul>
		</section>
		<div id="podcasts" class="border-rule mb-8 border-t pt-12 pb-8">
			<h2 class="text-highlight mb-8 w-full text-center text-4xl font-bold">Podcasts</h2>
			<div class="flex flex-wrap">
				{podcasts.items.map((podcast) => (
					<div class="m-4 md:m-8 md:flex-1">
						<p class="mb-4 text-lg">{podcast.label}</p>
						<div set:html={lazyIframes(podcast.html)} />
					</div>
				))}
			</div>
		</div>
	</div>
</Layout>
