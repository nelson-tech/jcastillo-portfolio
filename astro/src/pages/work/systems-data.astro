---
import PageHeader from "@components/PageHeader.astro"
import Layout from "@layouts/Layout.astro"
import { systemsData } from "@lib/content"

const { page, caseStudies, stack, agents, career, links } = systemsData
---

<Layout title={page.title ?? "Systems & Data"}>
	<div class="mx-4 mt-16 md:mx-8">
		{page.header && <PageHeader header={page.header} description={page.description} />}
		<div id="case-studies" class="mb-8 mt-8 pb-8">
			{
				caseStudies.header && (
					<h2 class="font-display text-ink mb-8 w-full text-center text-3xl font-semibold tracking-normal">{caseStudies.header}</h2>
				)
			}
			<div class="mx-auto grid max-w-3xl grid-cols-2 gap-6">
				{caseStudies.items.map((study) => (
					<a
						href={`#${study.logo.slug}`}
						title={`${study.name} case study`}
						class={`group flex aspect-[3/2] items-center justify-center rounded-sm border border-rule p-8 transition-colors duration-200 ease-out hover:border-ink ${study.logo.bg === "ink" ? "bg-ink" : "bg-white"}`}
					>
						<img src={study.logo.src} alt={study.logo.alt} class="max-h-24 w-auto max-w-[70%] object-contain transition-transform duration-300 ease-out group-hover:scale-105" />
					</a>
				))}
			</div>
			<div class="mx-auto mt-16 max-w-3xl">
				{caseStudies.items.map((study) => (
					<section id={study.logo.slug} class="case-study border-rule scroll-mt-24 border-t py-10 text-lg">
						<div class="flex items-baseline justify-between gap-4">
							<h3 class="font-display !mt-0 text-3xl">{study.name}</h3>
							<a href={study.link} target="_blank" rel="noopener" class="visit">Visit site &rarr;</a>
						</div>
						<p class="text-stone mt-2">{study.summary}</p>
						{study.problem && (<><h4>Problem</h4><p>{study.problem}</p></>)}
						{study.built.length > 0 && (<><h4>Built</h4><ul>{study.built.map((item) => <li>{item}</li>)}</ul></>)}
						{study.results.length > 0 && (<><h4>Results</h4><ul>{study.results.map((item) => <li>{item}</li>)}</ul></>)}
						<div class="mt-6 flex flex-wrap gap-2">{study.stack.map((item) => <span class="pill">{item}</span>)}</div>
					</section>
				))}
			</div>
		</div>
		<div id="stack" class="border-rule mb-8 border-t pt-12 pb-8">
			{stack.header && <h2 class="font-display text-ink mb-8 w-full text-center text-3xl font-semibold tracking-normal">{stack.header}</h2>}
			<div class="mx-auto flex max-w-3xl flex-wrap justify-center gap-3 text-lg">
				{stack.items.map((item) => (
					<span class="pill">{item}</span>
				))}
			</div>
		</div>
		<div id="agents" class="border-rule mb-8 border-t pt-12 pb-8">
			{agents.header && <h2 class="font-display text-ink mb-8 w-full text-center text-3xl font-semibold tracking-normal">{agents.header}</h2>}
			<p class="mx-auto max-w-2xl text-center text-xl leading-loose tracking-wider text-gray-700">{agents.text}</p>
		</div>
		<div id="career" class="border-rule mb-8 border-t pt-12 pb-8">
			{career.header && <h2 class="font-display text-ink mb-8 w-full text-center text-3xl font-semibold tracking-normal">{career.header}</h2>}
			<div class="mx-auto grid max-w-4xl grid-cols-1 gap-8 text-center md:grid-cols-2">
				{career.items.map((item) => (
					<div>
						<p class="text-xl font-bold">{item.company}</p>
						<p class="mt-2 text-lg">{item.text}</p>
					</div>
				))}
			</div>
		</div>
		<div id="links" class="mb-8 flex flex-wrap justify-center gap-8 text-xl font-bold">
			{links.map((link) => (
				<a href={link.url} target="_blank" rel="noopener">
					{link.label}
				</a>
			))}
		</div>
	</div>
</Layout>

<style>
	.case-study h4 {
		@apply text-stone mt-6 text-sm font-semibold uppercase tracking-widest;
	}
	.visit {
		@apply text-accent-deep whitespace-nowrap text-base underline-offset-4 hover:underline;
	}

	.case-study ul {
		@apply ml-6 list-disc;
	}

	.case-study li {
		@apply mt-1;
	}

	.pill {
		@apply border-rule text-stone rounded-full border bg-white px-3 py-1 text-sm;
	}

	#links a {
		@apply text-accent-deep underline-offset-4 transition-colors hover:text-ink hover:underline;
	}
</style>
