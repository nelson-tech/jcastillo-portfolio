---
import Card from "@components/Card.astro"
import PageHeader from "@components/PageHeader.astro"
import Layout from "@layouts/Layout.astro"
import { systemsData } from "@lib/content"

const { page, caseStudies, stack, agents, career, links } = systemsData
---

<Layout title={page.title ?? "Systems & Data"}>
	<div class="mx-4 mt-16 md:mx-8">
		{page.header && <PageHeader header={page.header} description={page.description} />}
		<div id="case-studies" class="border-highlight mb-8 mt-8 border-b border-opacity-50 pb-8">
			{
				caseStudies.header && (
					<h2 class="text-highlight mb-8 w-full text-center text-4xl font-bold">{caseStudies.header}</h2>
				)
			}
			<div class="mx-auto grid max-w-5xl grid-cols-1 gap-8 md:grid-cols-2">
				{caseStudies.items.map((study) => (
					<div class="flex flex-col gap-4">
						<ul>
							<Card title={study.name} body={study.summary} href={study.link} />
						</ul>
						<div class="case-study px-2 text-lg">
							{study.problem && (
								<>
									<h3>Problem</h3>
									<p>{study.problem}</p>
								</>
							)}
							{study.built.length > 0 && (
								<>
									<h3>Built</h3>
									<ul>
										{study.built.map((item) => (
											<li>{item}</li>
										))}
									</ul>
								</>
							)}
							{study.results.length > 0 && (
								<>
									<h3>Results</h3>
									<ul>
										{study.results.map((item) => (
											<li>{item}</li>
										))}
									</ul>
								</>
							)}
							<div class="mt-4 flex flex-wrap gap-2">
								{study.stack.map((item) => (
									<span class="pill">{item}</span>
								))}
							</div>
						</div>
					</div>
				))}
			</div>
		</div>
		<div id="stack" class="border-highlight mb-8 border-b border-opacity-50 pb-8">
			{stack.header && <h2 class="text-highlight mb-8 w-full text-center text-4xl font-bold">{stack.header}</h2>}
			<div class="mx-auto flex max-w-3xl flex-wrap justify-center gap-3 text-lg">
				{stack.items.map((item) => (
					<span class="pill">{item}</span>
				))}
			</div>
		</div>
		<div id="agents" class="border-highlight mb-8 border-b border-opacity-50 pb-8">
			{agents.header && <h2 class="text-highlight mb-8 w-full text-center text-4xl font-bold">{agents.header}</h2>}
			<p class="mx-auto max-w-2xl text-center text-xl leading-loose tracking-wider text-gray-700">{agents.text}</p>
		</div>
		<div id="career" class="border-highlight mb-8 border-b border-opacity-50 pb-8">
			{career.header && <h2 class="text-highlight mb-8 w-full text-center text-4xl font-bold">{career.header}</h2>}
			<div class="mx-auto grid max-w-4xl grid-cols-1 gap-8 text-center md:grid-cols-2">
				{career.items.map((item) => (
					<div>
						<p class="text-xl font-bold">{item.company}</p>
						<p class="mt-2 text-lg">{item.text}</p>
					</div>
				))}
			</div>
		</div>
		<div id="links" class="mb-8 flex flex-wrap justify-center gap-8 text-xl font-bold">
			{links.map((link) => (
				<a href={link.url} target="_blank" rel="noopener">
					{link.label}
				</a>
			))}
		</div>
	</div>
</Layout>

<style>
	.case-study h3 {
		@apply text-highlight mt-4 text-xl font-bold;
	}

	.case-study ul {
		@apply ml-6 list-disc;
	}

	.case-study li {
		@apply mt-1;
	}

	.pill {
		@apply border-highlight text-highlight rounded-full border border-opacity-50 bg-white bg-opacity-50 px-4 py-1;
	}

	#links a {
		@apply text-highlight transition-colors hover:text-green-500;
	}
</style>
