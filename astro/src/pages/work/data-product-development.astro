---
import PageHeader from "@components/PageHeader.astro"
import Picture from "@components/Picture.astro"
import Layout from "@layouts/Layout.astro"
import { dataEngineering } from "@lib/content"

import { stackMeta } from "@lib/stack"
import StackPill from "@components/StackPill.astro"
import CompanyLogo from "@components/CompanyLogo.astro"
const { page, caseStudies, stack, agents, career, links } = dataEngineering
const showcase = [{"slug": "label-performance", "label": "Label performance dashboard", "h": 1800, "mh": 1688}, {"slug": "market-share", "label": "Market share dashboard", "h": 1800, "mh": 1688}, {"slug": "kpi-funnel", "label": "KPI funnel dashboard", "h": 1822, "mh": 3016}, {"slug": "plan-revenue", "label": "Plan revenue dashboard", "h": 1800, "mh": 1688}, {"slug": "creator-cohorts", "label": "Creator cohorts dashboard", "h": 1980, "mh": 2258}]
const synthNote = "Recreated with synthetic data to protect confidential information."
---

<Layout title={page.title ?? "Data, Product & Development"}>
	<div class="mx-4 mt-16 md:mx-8">
		{page.header && <PageHeader header={page.header} description={page.description} />}
		<script is:inline>document.documentElement.classList.add("js")</script>
		<div id="case-studies" class="mb-8 mt-8 pb-8">
			<!-- Two rows of two: logo links to the live site; the toggle under it opens that case study below (one open at a time) -->
			<div class="mx-auto flex max-w-5xl flex-col items-center gap-y-6 py-6 md:gap-y-10">
				<div class="flex flex-nowrap items-start justify-center gap-x-5 md:gap-x-20">
					{caseStudies.items.slice(0, 2).map((study) => (
						<div class="flex flex-col items-center gap-2">
							<div class="flex h-[88px] items-center md:h-[176px]">
							<a href={study.link} target="_blank" rel="noopener" title={`${study.name} (opens in a new tab)`} class="logo-link group inline-flex items-center rounded-sm p-1 md:p-2">
								<Picture src={study.logo.src} alt={study.logo.alt} style={`--s:${study.logo.scale ?? 1}`} class={`case-logo ${study.logo.size} w-auto max-w-full object-contain opacity-90 transition duration-300 ease-out group-hover:-translate-y-0.5 group-hover:opacity-100`} />
							</a>
							</div>
							<button type="button" class="case-toggle" aria-expanded="false" aria-controls={`case-${study.logo.slug}`} data-case={study.logo.slug}>
								Case study <span class="sign" aria-hidden="true">+</span>
							</button>
						</div>
					))}
				</div>
				<div class="flex flex-nowrap items-start justify-center gap-x-5 md:gap-x-20">
					{caseStudies.items.slice(2, 4).map((study) => (
						<div class="flex flex-col items-center gap-2">
							<div class="flex h-[104px] items-center md:h-[192px]">
							<a href={study.link} target="_blank" rel="noopener" title={`${study.name} (opens in a new tab)`} class="logo-link group inline-flex items-center rounded-sm p-1 md:p-2">
								<Picture src={study.logo.src} alt={study.logo.alt} style={`--s:${study.logo.scale ?? 1}`} class={`case-logo ${study.logo.size} w-auto max-w-full object-contain opacity-90 transition duration-300 ease-out group-hover:-translate-y-0.5 group-hover:opacity-100`} />
							</a>
							</div>
							<button type="button" class="case-toggle" aria-expanded="false" aria-controls={`case-${study.logo.slug}`} data-case={study.logo.slug}>
								Case study <span class="sign" aria-hidden="true">+</span>
							</button>
						</div>
					))}
				</div>
			</div>
			<div class="mx-auto max-w-3xl">
				{caseStudies.items.map((study) => (
					<div id={`case-${study.logo.slug}`} class="case-panel" data-open="false" role="region" aria-label={`${study.name} case study`}>
						<div class="case-inner">
							<section class="case-study border-rule border-t py-8 text-lg">
								<h3 class="text-highlight !mt-0 text-2xl font-bold">{study.name}</h3>
								<p class="text-stone mt-2">{study.summary}</p>
								{study.problem && (<><h4>Problem</h4><p>{study.problem}</p></>)}
								{study.built.length > 0 && (<><h4>Built</h4><ul>{study.built.map((item) => <li>{item}</li>)}</ul></>)}
								{study.results.length > 0 && (<><h4>Results</h4><ul>{study.results.map((item) => <li>{item}</li>)}</ul></>)}
								<div class="mt-6 flex flex-wrap gap-2">{study.stack.map((item) => <StackPill name={item} />)}</div>
							</section>
						</div>
					</div>
				))}
			</div>
		</div>
		<div id="showcase" class="border-rule mb-8 border-t pt-12 pb-8">
			<h2 class="text-highlight mb-2 w-full text-center text-4xl font-bold">Business Intelligence</h2>
			<p class="text-stone mb-8 text-center text-base tracking-wider">Sample dashboards · synthetic data</p>
			<div class="sc-carousel mx-auto max-w-5xl" role="region" aria-roledescription="carousel" aria-label="Dashboard showcase">
				<div class="sc-track" tabindex="-1">
				{showcase.map((item, i) => (
					<figure class="synth sc-slide border-rule border" tabindex="0" role="group" aria-roledescription="slide" aria-label={`${i + 1} of ${showcase.length}: ${item.label}`}>
						<picture>
							<source media="(max-width: 700px)" srcset={i === 0 ? `/media/showcase/${item.slug}-390-1x.webp 1x, /media/showcase/${item.slug}-390.webp 2x` : `/media/showcase/${item.slug}-390.webp`} width="780" height={item.mh} />
							<img src={`/media/showcase/${item.slug}-1440.webp`} loading={i === 0 ? "eager" : "lazy"} decoding="async" fetchpriority={i === 0 ? "high" : undefined} width="2880" height={item.h} alt={`${item.label}. ${synthNote}`} class="block h-auto w-full" />
						</picture>
						<span class="synth-note" aria-hidden="true">{synthNote}</span>
					</figure>
				))}
				</div>
				<div class="sc-controls">
					<button type="button" class="sc-arrow" data-dir="-1" aria-label="Previous slide">&#8592;</button>
					<div class="sc-dots">
						{showcase.map((item, i) => (
							<button type="button" class="sc-dot" data-i={i} aria-label={`Show slide ${i + 1}: ${item.label}`} aria-current={i === 0 ? "true" : "false"}></button>
						))}
					</div>
					<button type="button" class="sc-arrow" data-dir="1" aria-label="Next slide">&#8594;</button>
				</div>
			</div>
		</div>
		<div id="stack" class="border-rule mb-8 border-t pt-12 pb-8">
			{stack.header && <h2 class="text-highlight mb-8 w-full text-center text-4xl font-bold">{stack.header}</h2>}
			<div class="mx-auto flex max-w-3xl flex-wrap justify-center gap-3 text-lg">
				{stack.items.map((item) => <StackPill name={item} />)}
			</div>
		</div>
		<div id="agents" class="border-rule mb-8 border-t pt-12 pb-8">
			{agents.header && <h2 class="text-highlight mb-8 w-full text-center text-4xl font-bold">{agents.header}</h2>}
			<p class="mx-auto max-w-2xl text-center text-xl leading-loose tracking-wider text-gray-700">{agents.text}</p>
			<ul class="agent-tools mx-auto mt-8 grid max-w-2xl grid-cols-2 justify-items-center gap-x-8 gap-y-4 sm:flex sm:flex-wrap sm:justify-center tracking-wider">
				{["Claude Code", "Cursor", "ChatGPT", "Grok Bot", "Muse Spark"].map((name) => {
					const meta = stackMeta[name]
					const ic = meta.icons[0]
					return (
						<li>
							<a href={meta.href} target="_blank" rel="noopener" style={`--brand:${ic.color}`}>
								{ic.kind === "brand" && <svg viewBox="0 0 24 24" aria-hidden="true"><path d={ic.d} fill-rule={ic.evenodd ? "evenodd" : undefined} /></svg>}
								<span>{name}</span>
							</a>
						</li>
					)
				})}
			</ul>
		</div>
		<div id="career" class="border-rule mb-8 border-t pt-12 pb-8">
			{career.header && <h2 class="text-highlight mb-10 w-full text-center text-4xl font-bold">{career.header}</h2>}
			<ul class="alumni mx-auto grid px-6 md:px-0 max-w-4xl grid-cols-6 items-center gap-x-4 gap-y-8 md:grid-cols-12 md:gap-x-10">
				{career.items.map((item) => (
					<li class="flex justify-center">
						<CompanyLogo src={item.logo.src} alt={item.logo.alt} href={item.logo.url} title={item.logo.url ? `${item.company} (opens in a new tab)` : item.company} scale={item.logo.size} />
					</li>
				))}
			</ul>
		</div>
		{links.length > 0 && (<div id="links" class="mb-8 flex flex-wrap justify-center gap-8 text-xl font-bold">
			{links.map((link) => (
				<a href={link.url} target="_blank" rel="noopener">
					{link.label}
				</a>
			))}
		</div>)}
	</div>
<script is:inline>
	// Swup swaps #swup on client-side nav; Astro's hoisted module scripts run once per
	// document, so per-element listeners never bound when arriving via swup. Use one
	// delegated document listener (guarded) and re-init panel state on every run
	// (swup's scripts plugin re-executes inline scripts after each swap / popstate).
	;(() => {
		const setOpen = (btn, open) => {
			const panel = document.getElementById(btn.getAttribute("aria-controls"))
			btn.setAttribute("aria-expanded", String(open))
			const sign = btn.querySelector(".sign")
			if (sign) sign.textContent = open ? "\u2212" : "+"
			if (panel) {
				panel.dataset.open = String(open)
				panel.toggleAttribute("inert", !open)
			}
		}
		document.querySelectorAll(".case-toggle").forEach((btn) => setOpen(btn, false))
		if (window.__caseToggles) return
		window.__caseToggles = true
		const reduce = window.matchMedia("(prefers-reduced-motion: reduce)")
		const CLOSE_MS = 240
		let pending
		document.addEventListener("click", (event) => {
			const btn = event.target.closest && event.target.closest(".case-toggle")
			if (!btn) return
			const toggles = [...document.querySelectorAll(".case-toggle")]
			const open = btn.getAttribute("aria-expanded") !== "true"
			window.clearTimeout(pending)
			const others = toggles.filter((o) => o !== btn)
			const wasOpen = others.some((o) => o.getAttribute("aria-expanded") === "true")
			others.forEach((other) => setOpen(other, false))
			if (open && wasOpen && !reduce.matches) {
				btn.setAttribute("aria-expanded", "true")
				btn.querySelector(".sign").textContent = "\u2212"
				pending = window.setTimeout(() => setOpen(btn, true), CLOSE_MS)
			} else {
				setOpen(btn, open)
			}
		})
	})()
	;(() => {
		const go = (car, i) => {
			const track = car.querySelector(".sc-track")
			const slides = track.children
			i = Math.max(0, Math.min(slides.length - 1, i))
			track.scrollTo({ left: slides[i].offsetLeft - track.offsetLeft, behavior: matchMedia("(prefers-reduced-motion: reduce)").matches ? "auto" : "smooth" })
		}
		const current = (car) => {
			const t = car.querySelector(".sc-track")
			if (!t.clientWidth) return 0
			return Math.max(0, Math.min(t.children.length - 1, Math.round(t.scrollLeft / t.clientWidth)))
		}
		document.querySelectorAll(".sc-carousel").forEach((car) => {
			const track = car.querySelector(".sc-track")
			const dots = [...car.querySelectorAll(".sc-dot")]
			const arrows = car.querySelectorAll(".sc-arrow")
			const sync = () => {
				if (!track.isConnected || !track.clientWidth) return
				const i = current(car)
				dots.forEach((d, j) => d.setAttribute("aria-current", String(j === i)))
				// Track follows the visible slide's height so short slides don't leave a gap under them.
				// Never move the page: pin scrollY across the height change (no scroll anchoring jump).
				const y = window.scrollY
				track.style.height = track.children[i].offsetHeight + "px"
				// Scroll anchoring can still nudge the page while the height animates; hold it for the transition.
				const until = performance.now() + 300
				const pin = () => {
					if (window.scrollY !== y) window.scrollTo(0, y)
					if (performance.now() < until) requestAnimationFrame(pin)
				}
				pin()
				arrows[0].disabled = i === 0
				arrows[1].disabled = i === dots.length - 1
			}
			let raf
			track.addEventListener("scroll", () => { cancelAnimationFrame(raf); raf = requestAnimationFrame(sync) }, { passive: true })
			sync()
			if (window.ResizeObserver) new ResizeObserver(sync).observe(track.children[0])
		})
		if (window.__scCarousel) return
		window.__scCarousel = true
		document.addEventListener("click", (event) => {
			const car = event.target.closest && event.target.closest(".sc-carousel")
			if (!car) return
			const arrow = event.target.closest(".sc-arrow")
			const dot = event.target.closest(".sc-dot")
			if (arrow) go(car, current(car) + Number(arrow.dataset.dir))
			else if (dot) go(car, Number(dot.dataset.i))
		})
		document.addEventListener("keydown", (event) => {
			if (event.key !== "ArrowLeft" && event.key !== "ArrowRight") return
			const car = event.target.closest && event.target.closest(".sc-carousel")
			if (!car) return
			event.preventDefault()
			const i = current(car) + (event.key === "ArrowRight" ? 1 : -1)
			go(car, i)
			const slide = car.querySelector(".sc-track").children[Math.max(0, Math.min(4, i))]
			if (event.target.classList.contains("sc-slide")) slide.focus({ preventScroll: true })
		})
	})()
	;(() => {
		document.querySelectorAll(".synth.is-open").forEach((f) => f.classList.remove("is-open"))
		if (window.__synthNotes) return
		window.__synthNotes = true
		document.addEventListener("click", (event) => {
			const fig = event.target.closest && event.target.closest(".synth")
			document.querySelectorAll(".synth.is-open").forEach((f) => { if (f !== fig) f.classList.remove("is-open") })
			if (fig) fig.classList.toggle("is-open")
		})
	})()
</script>
</Layout>



<style>
	/* Case-study logos stay large heroes; weight correction uses the same --s as CompanyLogo */
	:global(.case-logo) { transform: scale(var(--s, 1)); }
	.synth {
		position: relative;
		-webkit-tap-highlight-color: transparent;
		outline-offset: 3px;
	}
	.synth:focus { outline: none; }
	.synth:focus-visible { outline: 2px solid #6b7176; outline-offset: 4px; }
	.synth-note {
		position: absolute;
		right: 12px;
		bottom: 12px;
		max-width: calc(100% - 24px);
		box-sizing: border-box;
		font: 12px/1.35 basic-sans, system-ui, sans-serif;
		color: rgb(22 25 28 / 0.7);
		background: rgb(245 243 238 / 0.9);
		border: 1px solid #dedad2;
		border-radius: 4px;
		padding: 4px 8px;
		opacity: 0;
		transition: opacity 150ms ease;
		pointer-events: none;
	}
	.synth:hover .synth-note,
	.synth:focus-visible .synth-note,
	.synth:focus-within .synth-note,
	.synth.is-open .synth-note { opacity: 1; }
	@media (prefers-reduced-motion: reduce) { .synth-note { transition: none; } }
	.sc-track {
		overflow-anchor: none;
		display: flex;
		align-items: flex-start;
		gap: 16px;
		overflow-x: auto;
		scroll-snap-type: x mandatory;
		overscroll-behavior-x: contain;
		scrollbar-width: none;
		-webkit-overflow-scrolling: touch;
		transition: height 200ms ease;
	}
	.sc-track::-webkit-scrollbar { display: none; }
	.sc-slide:focus-visible { outline-offset: -2px; }
	.sc-slide { flex: 0 0 100%; scroll-snap-align: start; scroll-snap-stop: always; margin: 0; }
	.sc-controls { display: flex; align-items: center; justify-content: center; gap: 16px; margin-top: 16px; }
	.sc-arrow {
		width: 32px; height: 32px; border: 1px solid #dedad2; border-radius: 4px; background: transparent;
		color: #16191c; font-size: 14px; line-height: 1; -webkit-tap-highlight-color: transparent;
		transition: border-color 150ms ease;
	}
	.sc-arrow:hover:not(:disabled) { border-color: #6b7176; }
	.sc-arrow:disabled { opacity: 0.35; cursor: default; }
	.sc-dots { display: flex; gap: 4px; }
	.sc-dot {
		width: 24px; height: 24px; padding: 0; border: 0; background: transparent; position: relative;
		-webkit-tap-highlight-color: transparent;
	}
	.sc-dot::after {
		content: ""; position: absolute; inset: 8px; border-radius: 50%; border: 1px solid #dedad2; background: transparent;
		transition: background-color 150ms ease;
	}
	.sc-dot[aria-current="true"]::after { background: #16191c; border-color: #16191c; }
	@media (prefers-reduced-motion: reduce) { .sc-track, .sc-arrow, .sc-dot::after { transition: none; } }
	.case-toggle {
		@apply text-highlight rounded-sm text-base underline-offset-4 hover:underline;
	}
	.case-toggle .sign {
		@apply inline-block w-3 text-center;
	}
	/* Without JS every card is shown open and the toggles are hidden; JS adds html.js. */
	.case-toggle {
		display: none;
	}
	:global(html.js) .case-toggle {
		display: inline-block;
	}
	:global(html.js) .case-panel {
		display: grid;
		grid-template-rows: 0fr;
		opacity: 0;
		/* Closing: fade text out quickly, then finish collapsing the height. */
		transition: opacity 120ms ease-out, grid-template-rows 220ms ease-in-out;
	}
	:global(html.js) .case-panel[data-open="true"] {
		grid-template-rows: 1fr;
		opacity: 1;
		/* Opening: grow the height, fade text in once there is room for it. */
		transition: grid-template-rows 260ms ease-out, opacity 180ms ease-out 100ms;
	}
	:global(html.js) .case-inner {
		overflow: hidden;
		min-height: 0;
	}
	@media (prefers-reduced-motion: reduce) {
		:global(html.js) .case-panel,
		:global(html.js) .case-panel[data-open="true"] {
			transition: none;
		}
	}
	.case-study h4 {
		@apply text-highlight mt-4 text-xl font-bold;
	}
	.visit {
		@apply text-accent-deep whitespace-nowrap text-base underline-offset-4 hover:underline;
	}

	.case-study ul {
		@apply ml-6 list-disc;
	}

	.case-study li {
		@apply mt-1;
	}

	.agent-tools a {
		@apply text-stone inline-flex items-center gap-2 transition-colors;
	}
	.agent-tools svg {
		width: 1.1em;
		height: 1.1em;
		fill: currentColor;
	}
	.agent-tools a:hover,
	.agent-tools a:focus-visible {
		color: var(--brand);
	}
	@media (prefers-reduced-motion: reduce) {
		.agent-tools a { transition: none; }
	}

	/* Every logo gets the same box; --s is an optical-weight correction per logo. */
	/* 7 logos: 3 + 2 + 2 on mobile, 4 + 3 on desktop (no lone orphan) */
	.alumni > li { grid-column: span 2; }
	.alumni > li:nth-child(n + 4) { grid-column: span 3; }
	@media (min-width: 768px) {
		.alumni > li { grid-column: span 3; }
		.alumni > li:nth-child(n + 5) { grid-column: span 4; }
	}

	#links a {
		@apply text-accent-deep underline-offset-4 transition-colors hover:text-ink hover:underline;
	}
</style>
