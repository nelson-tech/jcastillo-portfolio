---
import PageHeader from "@components/PageHeader.astro"
import Video from "@components/Video.astro"
import Layout from "@layouts/Layout.astro"
import { videos } from "@lib/content"

const { page } = videos
const sections = [
	{ id: "vr", class: "pt-4 pb-8", ...videos.vr },
	{ id: "editing", class: "border-rule mb-8 border-t pt-12 pb-8", ...videos.editing },
	{ id: "commercial", class: "border-rule mb-8 border-t pt-12 pb-8", ...videos.commercial }
]
---

<Layout title={page.title ?? "Video"}>
	<div class="mx-4 md:mx-8">
		{page.header && <PageHeader header={page.header} description={page.description} />}
		<div id="videos" class="mt-8">
			{sections.map((section) => (
				<div class:list={["text-center", section.class]}>
					{section.header && <h2 id={section.id} class="text-highlight mb-8 w-full text-center text-4xl font-bold">{section.header}</h2>}
					<div class="mt-8 flex flex-wrap items-center justify-center gap-4">
						{section.videos.map((video) => (
							<div class="overflow-hidden rounded">
								<Video video={video} />
							</div>
						))}
					</div>
				</div>
			))}
		</div>
	</div>
</Layout>
