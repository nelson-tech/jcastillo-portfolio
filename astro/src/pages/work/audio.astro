---
import PageHeader from "@components/PageHeader.astro"
import Video from "@components/Video.astro"
import Layout from "@layouts/Layout.astro"
import { audio } from "@lib/content"
import { lazyIframes } from "@lib/embeds"

const { page, soundDesign, audioEngineering } = audio
---

<Layout title={page.title ?? "Audio"}>
	<div class="mx-4 mt-16 md:mx-8">
		{page.header && <PageHeader header={page.header} description={page.description} />}
		<div id="audio" class="mt-8">
			<div id="motion_graphics" class="pt-4 pb-8 text-center">
				{soundDesign.header && <h2 class="text-highlight mb-8 w-full text-center text-4xl font-bold">{soundDesign.header}</h2>}
				{soundDesign.description && <p class="mt-4 text-lg">{soundDesign.description}</p>}

				<div class="mx-auto mt-8 grid max-w-[1040px] grid-cols-1 justify-items-center gap-4 md:grid-cols-2">
					{soundDesign.videos.map((video) => (
						<div class:list={["flex w-full justify-center overflow-hidden rounded", soundDesign.videos.length === 1 && "md:col-span-2"]}>
							<Video video={video} />
						</div>
					))}
				</div>
			</div>
			<div id="audio-engineering" class="border-rule mb-8 border-t pt-12 pb-8 text-center">
				{audioEngineering.header && (
					<h2 class="text-highlight mb-8 w-full text-center text-4xl font-bold">{audioEngineering.header}</h2>
				)}
				{audioEngineering.description && <p class="mt-4 text-lg">{audioEngineering.description}</p>}
				<div class="flex flex-col items-center justify-center">
					{audioEngineering.embeds.map((embed) => (
						<div class="m-4 w-full md:m-8 md:w-1/2">
							<div set:html={lazyIframes(embed.html)} />
						</div>
					))}
				</div>
			</div>
		</div>
	</div>
</Layout>
