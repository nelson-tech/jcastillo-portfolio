---
import PageHeader from "@components/PageHeader.astro"
import Video from "@components/Video.astro"
import MosaicGallery from "@components/MosaicGallery.astro"
import Layout from "@layouts/Layout.astro"
import { imageInfo } from "@lib/images"
import { design } from "@lib/content"

const { page, motionGraphics, graphicDesign } = design
const first = motionGraphics.videos[0]
const thumbInfo = first?.provider === "youtube" ? imageInfo(`/media/thumbs/${first.id}.jpg`) : undefined
const preload = thumbInfo
	? { src: thumbInfo.avif.at(-1)!.src, srcset: thumbInfo.avif.map((v) => `${v.src} ${v.w}w`).join(", "), sizes: "(min-width: 1072px) 1040px, calc(100vw - 32px)", type: "image/avif" }
	: undefined
---

<Layout title={page.title ?? "Design"} preloadImage={preload}>
	<div class="mx-4 mt-16 md:mx-8">
		{page.header && <PageHeader header={page.header} description={page.description} />}
		<div id="design" class="mt-8">
			<div id="motion_graphics" class="pt-4 pb-8 text-center">
				{motionGraphics.header && (
					<h2 class="text-highlight mb-8 w-full text-center text-4xl font-bold">{motionGraphics.header}</h2>
				)}
				{motionGraphics.description && <p class="mt-4 text-lg">{motionGraphics.description}</p>}

				<div class="mx-auto mt-8 grid max-w-[1040px] grid-cols-1 justify-items-center gap-4 md:grid-cols-2">
					{motionGraphics.videos.map((video, i) => (
						<div class:list={["w-full overflow-hidden rounded flex justify-center", i === 0 && motionGraphics.videos.length % 2 === 1 && "w-full md:col-span-2"]}>
							<Video video={video} featured={i === 0 && motionGraphics.videos.length % 2 === 1} />
						</div>
					))}
				</div>
			</div>
			<div id="graphic_design" class="border-rule mb-8 border-t pt-12 pb-8 text-center">
				{graphicDesign.header && <h2 class="text-highlight mb-8 w-full text-center text-4xl font-bold">{graphicDesign.header}</h2>}
				{graphicDesign.description && <p class="mt-4 text-lg">{graphicDesign.description}</p>}
				<div class="mt-8 text-left"><MosaicGallery items={graphicDesign.images} /></div>
			</div>
		</div>
	</div>
</Layout>

