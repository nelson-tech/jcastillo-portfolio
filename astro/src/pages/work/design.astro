---
import PageHeader from "@components/PageHeader.astro"
import Video from "@components/Video.astro"
import Photograph from "@components/Photograph.svelte"
import Layout from "@layouts/Layout.astro"
import { design } from "@lib/content"

const { page, motionGraphics, graphicDesign } = design
---

<Layout title={page.title ?? "Design"}>
	<div class="mx-4 md:mx-8">
		{page.header && <PageHeader header={page.header} description={page.description} />}
		<div id="design" class="mt-8">
			<div id="motion_graphics" class="text-center">
				{motionGraphics.header && (
					<h3 class="text-highlight text-2xl font-bold">{motionGraphics.header}</h3>
				)}
				{motionGraphics.description && <p class="mt-4 text-lg">{motionGraphics.description}</p>}

				<div class="mt-8 flex flex-wrap items-center justify-center gap-4">
					{motionGraphics.videos.map((video) => (
						<div class="overflow-hidden rounded">
							<Video video={video} />
						</div>
					))}
				</div>
			</div>
			<div id="graphic_design" class="mt-16 text-center">
				{graphicDesign.header && <h3 class="text-highlight text-2xl font-bold">{graphicDesign.header}</h3>}
				{graphicDesign.description && <p class="mt-4 text-lg">{graphicDesign.description}</p>}
				<div class="flex flex-wrap items-center justify-center">
					{graphicDesign.images.map((image) => (
						<div class="basis-1/1 mx-8 mt-8 md:basis-1/3">
							<Photograph image={image} client:load />
						</div>
					))}
				</div>
			</div>
		</div>
	</div>
</Layout>
