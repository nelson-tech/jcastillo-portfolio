---
import Layout from "@layouts/Layout.astro"
import PageHeader from "@components/PageHeader.astro"
import { contact } from "@lib/content"

const subject = encodeURIComponent("Hello from josecastillocorcuera.com")
const mailto = `mailto:${contact.email}?subject=${subject}`
---

<Layout title="Contact">
	<section class="text-ink mx-auto w-full max-w-xl px-8 pb-16 pt-4 tracking-wider" aria-label="Contact">
		<PageHeader header="Contact" />
		<p class="text-stone mt-6 text-center text-xl leading-loose">Interested in working together? Send me a note and I'll get back to you.</p>

		<div class="mt-10 flex flex-col items-center gap-4">
			<a href={mailto} class="submit">Email me</a>
			<!-- Do not show the email address as text here (Jose's call). tests/contact-no-email.test.mjs enforces it. -->
		</div>
	</section>
</Layout>

<style>
	.submit {
		@apply border-highlight text-highlight hover:bg-highlight inline-block rounded-full border px-8 py-3 text-lg tracking-widest transition-colors hover:text-white focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2;
	}
	@media (prefers-reduced-motion: reduce) {
		.submit { transition: none; }
	}
</style>
