---
import ProjectCard from "@components/ProjectCard.astro"
import Layout from "@layouts/Layout.astro"
import { work } from "@lib/content"

const { categories } = work
---

<Layout title="Work">
	<div class="mx-auto grid w-full max-w-6xl grid-cols-1 gap-x-8 gap-y-12 px-4 md:mt-8 md:grid-cols-2 md:px-8">
		{
			categories.map((category) => <ProjectCard category={category} />)
		}
	</div>
</Layout>
