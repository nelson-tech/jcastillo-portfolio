---
interface Props {
	header: string
	description?: string | null
}

const { header, description } = Astro.props
---

<h1 class="font-display text-ink mt-8 mb-4 text-center text-5xl font-semibold tracking-normal md:text-6xl">
	{header}
</h1>
{description && <p class="text-stone text-center text-lg">{description}</p>}
