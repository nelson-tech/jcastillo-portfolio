---
export interface Props {
	title: string
	body: string
	href: string
}

const { href, title, body } = Astro.props
---

<li class="link-card">
	<a href={href}>
		<h2>{title} <span aria-hidden="true">&rarr;</span></h2>
		<p>{body}</p>
	</a>
</li>
<style>
	.link-card { list-style: none; }
	.link-card > a {
		display: block;
		padding: 1.25rem 1.5rem;
		border: 1px solid #DEDAD2;
		border-radius: 4px;
		background: #fff;
		color: #16191C;
		text-decoration: none;
		transition: border-color 200ms ease-out, transform 200ms ease-out;
	}
	h2 { margin: 0; font-size: 1.375rem; font-weight: 600; }
	h2 span { display: inline-block; transition: transform 200ms ease-out; }
	p { margin: 0.5rem 0 0; color: #6B7176; line-height: 1.5; }
	.link-card > a:is(:hover, :focus-visible) { border-color: #16191C; }
	.link-card > a:is(:hover, :focus-visible) h2 span { transform: translateX(4px); }
</style>
