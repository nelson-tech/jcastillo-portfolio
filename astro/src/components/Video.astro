---
import type { Video } from "@lib/content"

interface Props {
	video: Video
}

const { video } = Astro.props
---

<div class="video-js aspect-video w-full max-w-lg overflow-hidden rounded md:min-h-[280px]">
	{
		video.provider === "youtube" ? (
			<iframe src={`https://www.youtube.com/embed/${video.id}`} class="h-full w-full" />
		) : (
			<iframe allow="autoplay" src={`https://player.vimeo.com/video/${video.id}`} class="h-full w-full" />
		)
	}
</div>
