---
import type { work } from "@lib/content"

export interface Props {
	category: (typeof work)["categories"][number]
	index: number
}
const { category, index } = Astro.props
---

<a href={`/work/${category.slug}`} class={`group block ${category.wide ? "md:col-span-2" : ""}`}>
	<div class={`overflow-hidden rounded-sm bg-ink aspect-[3/2] ${category.wide ? "md:aspect-[12/5]" : ""}`}>
		<picture>
			{category.wide && category.image.wideSrc && <source media="(min-width: 768px)" srcset={category.image.wideSrc} />}
			<img
				src={category.image.src}
				alt={category.image.alt}
				loading="lazy"
				class="h-full w-full object-cover object-center transition duration-500 ease-out group-hover:scale-[1.03]"
			/>
		</picture>
	</div>
	<div class="mt-3 flex items-baseline justify-between border-b border-rule pb-3">
		<span class="flex items-baseline gap-3"><span class="text-stone text-xs tabular-nums tracking-widest">{String(index + 1).padStart(2, "0")}</span><span class="font-display text-ink text-xl font-semibold tracking-normal">{category.name}</span></span>
		<span aria-hidden="true" class="text-stone transition-transform duration-200 ease-out group-hover:translate-x-1 group-hover:text-ink">&rarr;</span>
	</div>
</a>
